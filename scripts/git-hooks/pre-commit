#!/bin/bash
# Pre-commit hook: security scan + Python/JS syntax + E2E smoke tests
set -e

ROOT="$(git rev-parse --show-toplevel)"
STAGED=$(git diff --cached --name-only --diff-filter=ACM)

# amux-staged-guard — blocks committing another session's WIP out of this
# shared checkout. The call is unconditional here on purpose: it was previously
# hand-added to the INSTALLED copy only, which left re-running install-hooks.sh
# one command away from silently disabling it while the guard file sat there
# looking installed.
#
# ABSENCE IS LOUD, and that is not optional (2026-08-06). The same defect the
# comment above describes had simply moved one level down: the CALL was tracked
# but the guard SCRIPT was not — `amux-staged-guard` existed only in
# .git/hooks/, which git does not track, so a fresh clone ran install-hooks.sh,
# got this hook, found no guard beside it, and silently had cross-session sweep
# protection OFF. Fixing the caller and not the callee is how a fix looks
# complete while the hole stays open. The guard is now tracked in
# scripts/git-hooks/ and installed by install-hooks.sh; this else branch is the
# backstop for the case where it goes missing again, because a protection that
# disappears quietly is worse than one that was never claimed.
g="$(dirname -- "$0")/amux-staged-guard"
if [ -x "$g" ]; then
  "$g" || exit 1
else
  echo "amux: staged-guard MISSING at $g — cross-session sweep protection is OFF (AMUX-1730)." >&2
  echo "amux: run ./scripts/install-hooks.sh to restore it." >&2
fi

# ── 1. Security scan (runs on every commit) ─────────────────────────────────

BLOCKED_FILES=(
  "terraform.tfvars"
  ".env.local"
  "*.pem"
  "*.key"
  "*.p12"
  "*.pfx"
  "id_rsa"
  "id_ecdsa"
  "id_ed25519"
)

# Patterns matched against added/modified lines in staged content
SECRET_PATTERNS=(
  "-----BEGIN .* PRIVATE KEY|-----BEGIN PRIVATE KEY"       # private keys
  "sk-ant-api[0-9a-zA-Z-]{20,}"                           # Anthropic API keys
  "tskey-auth-[A-Za-z0-9]+"                               # Tailscale auth keys
  "AKIA[0-9A-Z]{16}"                                      # AWS access key IDs
  "ghp_[A-Za-z0-9]{36}"                                   # GitHub personal tokens
  "github_pat_[A-Za-z0-9_]+"                              # GitHub fine-grained PATs
  "AIza[0-9A-Za-z_-]{35}"                                 # Google API keys
  "sk-[a-zA-Z0-9]{48}"                                    # OpenAI-style keys
  # AC-239: FOUR credentials sat committed in cloud/setup-cloud.sh since
  # 2026-03-11 — Clerk sk_test_, R2 access+secret, CF account id — and this
  # scanner matched NONE of them. The R2 pair is what litestream uses to
  # replicate every per-user database, in a PUBLIC repo. Every pattern below
  # was added by testing it against that exact block first; a secret scanner
  # whose patterns were never run against a real leak is theatre.
  "sk_(test|live)_[A-Za-z0-9]{20,}"                       # Clerk / Stripe secret keys
  "(R2|AWS)_SECRET(_ACCESS)?_KEY[[:space:]]*=[[:space:]]*[A-Za-z0-9/+]{32,}"   # R2/S3 secrets
  "CLERK_SECRET_KEY[[:space:]]*=[[:space:]]*[A-Za-z0-9_-]{20,}"
  "xox[baprs]-[A-Za-z0-9-]{10,}"                          # Slack tokens
  "glpat-[A-Za-z0-9_-]{20,}"                              # GitLab PATs
)

SECRETS_FOUND=0

# Check blocked filenames
for f in $STAGED; do
  base="$(basename "$f")"
  for pattern in "${BLOCKED_FILES[@]}"; do
    # shellcheck disable=SC2053
    if [[ "$base" == $pattern ]]; then
      echo "✗ BLOCKED FILE: $f matches sensitive filename pattern '$pattern'"
      SECRETS_FOUND=1
    fi
  done
done

# Check staged content for secret patterns (only added lines, skip binary files)
ADDED_LINES=$(git diff --cached --diff-filter=ACM -U0 2>/dev/null \
  | grep "^+" \
  | grep -v "^+++" \
  || true)

if [ -n "$ADDED_LINES" ]; then
  for pattern in "${SECRET_PATTERNS[@]}"; do
    # -e is REQUIRED: the private-key pattern starts with "-----", which grep
    # reads as options no matter how it is quoted. Without it that pattern died
    # with "grep: unrecognized option", the error went to stderr, `|| true`
    # swallowed the status, and the hook printed "Security scan passed" — so the
    # one check guarding against committing a private key had never once run.
    # Assign inside `if`: this script runs under `set -e`, and grep exits 1 on a
    # clean file, so a bare assignment would abort the hook — silently, mid-scan,
    # with a non-zero status git reports as a blocked commit and no reason why.
    if matches=$(echo "$ADDED_LINES" | grep -E -e "$pattern" 2>&1); then
      status=0
    else
      status=$?
    fi
    # grep: 0 = matched, 1 = no match, >1 = the pattern never ran. Treat that
    # last case as a failure instead of a pass — a scan that cannot report a
    # problem is worse than no scan, because the "passed" line gets trusted.
    if [ "$status" -gt 1 ]; then
      echo "✗ SECRET SCAN BROKEN: pattern '$pattern' did not run (grep exit $status)"
      echo "$matches" | head -2 | sed 's/^/    /'
      SECRETS_FOUND=1
    elif [ "$status" -eq 0 ]; then
      echo "✗ SECRET DETECTED matching pattern: $pattern"
      echo "$matches" | head -5 | sed 's/^/    /'
      SECRETS_FOUND=1
    fi
  done
fi

if [ "$SECRETS_FOUND" -eq 1 ]; then
  echo ""
  echo "Commit blocked. Remove the sensitive content and try again."
  echo "To skip this check (dangerous): git commit --no-verify"
  exit 1
fi

echo "Security scan passed."

# ── 2. Python + JS syntax (only when amux-server.py is staged) ──────────────

FILE="amux-server.py"

if echo "$STAGED" | grep -q "^${FILE}$"; then
  echo "Checking Python syntax..."
  python3 -c "import ast; ast.parse(open('$ROOT/$FILE').read())"

  echo "Checking JS syntax..."
  python3 -c "
import re, subprocess, sys, tempfile, os
with open('$ROOT/$FILE') as f:
    content = f.read()
blocks = re.findall(r'<script>\s*\n(.*?)</script>', content, re.DOTALL)
if not blocks:
    print('WARNING: no <script> block found'); sys.exit(0)
# This was re.search, which matches the FIRST block only: 2,379 of 1,296,891
# bytes, 0.2% of the client. The board/gate/session client is block 4 of 6 at
# 1.07MB and had NEVER been parsed here, while the step printed 'Syntax checks
# passed' on every commit that touched it (AMUX-2331). A green check that
# cannot see the code it claims to check is worse than no check.
fail = 0
for i, b in enumerate(blocks):
    fd, path = tempfile.mkstemp(suffix='.js')
    os.write(fd, b.encode())
    os.close(fd)
    r = subprocess.run(['node', '--check', path], capture_output=True, text=True)
    os.unlink(path)
    if r.returncode != 0:
        print('JS syntax error in <script> block %d of %d (%d bytes):' % (i + 1, len(blocks), len(b)))
        print(r.stderr)
        fail = 1
if fail:
    sys.exit(1)
print('  %d script block(s) parsed, %d bytes' % (len(blocks), sum(len(b) for b in blocks)))
"
  echo "Syntax checks passed."
fi

