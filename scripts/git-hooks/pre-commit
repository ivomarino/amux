#!/bin/bash
# amux-staged-guard  (see the block below for why this call is HERE now)
g="$(dirname -- "$0")/amux-staged-guard"
if [ -x "$g" ]; then "$g" || exit 1; else echo "amux: staged-guard MISSING at $g - cross-session sweep protection is OFF (AMUX-1730)" >&2; fi
# Pre-commit hook: security scan + Rust/client-JS syntax
set -e

ROOT="$(git rev-parse --show-toplevel)"
STAGED=$(git diff --cached --name-only --diff-filter=ACM)

# THE staged-guard CALL IS AT THE TOP OF THIS FILE AGAIN (2026-08-09), and the
# history below is why that is not a re-run of a mistake.
#
# It used to be injected by the server: `_install_amux_precommit_guard()` in
# amux-server.py generated `.git/hooks/amux-staged-guard` per work_dir and
# inserted a shim line into whatever pre-commit existed. On 2026-08-06 a
# session added a tracked copy plus a call here, and that was correctly
# reverted for two reasons — it made install-hooks.sh a SECOND producer of a
# generated file (running it overwrote the server's live guard with a frozen
# one, reverting AC-241), and the shim was already injected, so the guard ran
# TWICE and printed every NOTE twice.
#
# Both reasons are now dead. amux-server.py is deleted (rust cutover) and
# nothing in the rust server generates the hook or injects the shim, so:
#   1. there is no first producer to collide with — the tracked copy in
#      scripts/git-hooks/ is the only one; and
#   2. nothing injects a second call, so this one cannot duplicate.
#
# The cost of the old arrangement was measured: with no generator, this hook
# was whatever the retired python last wrote, and running install-hooks.sh —
# which overwrites this file — would have DELETED the injected shim and turned
# the guard off, while printing "ok ... matches". If a generator ever returns,
# delete this call and the tracked guard in the same commit that adds it.

# ── 1. Security scan (runs on every commit) ─────────────────────────────────

BLOCKED_FILES=(
  "terraform.tfvars"
  ".env.local"
  "*.pem"
  "*.key"
  "*.p12"
  "*.pfx"
  "id_rsa"
  "id_ecdsa"
  "id_ed25519"
)

# Patterns matched against added/modified lines in staged content
SECRET_PATTERNS=(
  "-----BEGIN .* PRIVATE KEY|-----BEGIN PRIVATE KEY"       # private keys
  "sk-ant-api[0-9a-zA-Z-]{20,}"                           # Anthropic API keys
  "tskey-auth-[A-Za-z0-9]+"                               # Tailscale auth keys
  "AKIA[0-9A-Z]{16}"                                      # AWS access key IDs
  "ghp_[A-Za-z0-9]{36}"                                   # GitHub personal tokens
  "github_pat_[A-Za-z0-9_]+"                              # GitHub fine-grained PATs
  "AIza[0-9A-Za-z_-]{35}"                                 # Google API keys
  "sk-[a-zA-Z0-9]{48}"                                    # OpenAI-style keys
  # AC-239: FOUR credentials sat committed in cloud/setup-cloud.sh since
  # 2026-03-11 — Clerk sk_test_, R2 access+secret, CF account id — and this
  # scanner matched NONE of them. The R2 pair is what litestream uses to
  # replicate every per-user database, in a PUBLIC repo. Every pattern below
  # was added by testing it against that exact block first; a secret scanner
  # whose patterns were never run against a real leak is theatre.
  "sk_(test|live)_[A-Za-z0-9]{20,}"                       # Clerk / Stripe secret keys
  "(R2|AWS)_SECRET(_ACCESS)?_KEY[[:space:]]*=[[:space:]]*[A-Za-z0-9/+]{32,}"   # R2/S3 secrets
  "CLERK_SECRET_KEY[[:space:]]*=[[:space:]]*[A-Za-z0-9_-]{20,}"
  "xox[baprs]-[A-Za-z0-9-]{10,}"                          # Slack tokens
  "glpat-[A-Za-z0-9_-]{20,}"                              # GitLab PATs
)

SECRETS_FOUND=0

# Check blocked filenames
for f in $STAGED; do
  base="$(basename "$f")"
  for pattern in "${BLOCKED_FILES[@]}"; do
    # shellcheck disable=SC2053
    if [[ "$base" == $pattern ]]; then
      echo "✗ BLOCKED FILE: $f matches sensitive filename pattern '$pattern'"
      SECRETS_FOUND=1
    fi
  done
done

# Check staged content for secret patterns (only added lines, skip binary files)
ADDED_LINES=$(git diff --cached --diff-filter=ACM -U0 2>/dev/null \
  | grep "^+" \
  | grep -v "^+++" \
  || true)

if [ -n "$ADDED_LINES" ]; then
  for pattern in "${SECRET_PATTERNS[@]}"; do
    # -e is REQUIRED: the private-key pattern starts with "-----", which grep
    # reads as options no matter how it is quoted. Without it that pattern died
    # with "grep: unrecognized option", the error went to stderr, `|| true`
    # swallowed the status, and the hook printed "Security scan passed" — so the
    # one check guarding against committing a private key had never once run.
    # Assign inside `if`: this script runs under `set -e`, and grep exits 1 on a
    # clean file, so a bare assignment would abort the hook — silently, mid-scan,
    # with a non-zero status git reports as a blocked commit and no reason why.
    if matches=$(echo "$ADDED_LINES" | grep -E -e "$pattern" 2>&1); then
      status=0
    else
      status=$?
    fi
    # grep: 0 = matched, 1 = no match, >1 = the pattern never ran. Treat that
    # last case as a failure instead of a pass — a scan that cannot report a
    # problem is worse than no scan, because the "passed" line gets trusted.
    if [ "$status" -gt 1 ]; then
      echo "✗ SECRET SCAN BROKEN: pattern '$pattern' did not run (grep exit $status)"
      echo "$matches" | head -2 | sed 's/^/    /'
      SECRETS_FOUND=1
    elif [ "$status" -eq 0 ]; then
      echo "✗ SECRET DETECTED matching pattern: $pattern"
      echo "$matches" | head -5 | sed 's/^/    /'
      SECRETS_FOUND=1
    fi
  done
fi

if [ "$SECRETS_FOUND" -eq 1 ]; then
  echo ""
  echo "Commit blocked. Remove the sensitive content and try again."
  echo "To skip this check (dangerous): git commit --no-verify"
  exit 1
fi

echo "Security scan passed."

# ── 2. Rust + client JS syntax (only when the workspace / dashboard is staged) ─
# The Python predecessor's ast.parse + inline-<script> extraction lived here
# until 2026-08-09; the client is real static files now and the server is Rust.

if echo "$STAGED" | grep -qE '^(crates/.*\.rs|Cargo\.(toml|lock))$'; then
  echo "Checking Rust (cargo check --workspace --all-targets)..."
  # --all-targets IS THE POINT, not a flourish (AMUX-2807).
  #
  # Plain `cargo check --workspace` does not compile test targets, so a break
  # that lives in `#[cfg(test)]` code sails through this gate and lands on
  # whoever runs tests next — which on a shared checkout is every other lane.
  # That happened TWICE on 2026-08-10 alone: a non-exhaustive match on
  # `DetectorKind::CiFailure`, and `title_needs_self_description` called from
  # orchestrator/runtime.rs before it existed in amux-core. Both passed this
  # hook. Both left `cargo test` red for the whole fleet, one of them for ~30
  # minutes, while `cargo check` reported green the entire time.
  #
  # Note what this does and does not buy: it compiles tests, it does not RUN
  # them. That is deliberate — running the suite is ~40s and this is every
  # commit on a machine hosting ~50 lanes. Compile errors are the class that
  # blocks OTHER PEOPLE; a failing assertion blocks only its author.
  #
  # Measured on this machine, warm cache: 3.75s -> 13.75s. Ten seconds a commit
  # against four fleet-wide blockages in one afternoon. If that trade ever stops
  # being worth it, drop the flag — but drop it knowing what it was buying.
  cargo check --workspace --all-targets --quiet
  echo "cargo check passed (including test targets)."
fi

JS_STAGED=$(echo "$STAGED" | grep -E '^crates/amux-dashboard/static/.*\.(js|mjs)$' || true)
if [ -n "$JS_STAGED" ]; then
  echo "Checking client JS syntax..."
  for f in $JS_STAGED; do
    node --check "$ROOT/$f"
  done
  echo "JS syntax checks passed."
fi
